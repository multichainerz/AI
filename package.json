{
  "name": "orcasynapse",
  "version": "1.70.0",
  "description": "OrcaSynapse - on-premises AI operations and agentic control plane",
  "license": "BUSL-1.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multichainerz/AI.git"
  },
  "homepage": "https://github.com/multichainerz/AI#readme",
  "bugs": {
    "url": "https://github.com/multichainerz/AI/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "24.13.3",
      "fast-uri": ">=4.1.2",
      "adm-zip": ">=0.6.0",
      "sharp": ">=0.35.3",
      "pdfjs-dist": ">=6.2.108"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "concurrently --kill-others --names api,web \"pnpm --filter @orcasynapse/api dev\" \"pnpm --filter @orcasynapse/web dev\"",
    "dev:worker": "pnpm --filter @orcasynapse/worker dev",
    "pretypecheck": "pnpm --filter @orcasynapse/contracts --filter @orcasynapse/database --filter @orcasynapse/security --filter @orcasynapse/runtime-clients build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm db:validate",
    "security:audit": "pnpm audit --prod --audit-level high",
    "admin:provision": "node scripts/provision-local-admin.mjs",
    "db:generate": "pnpm --filter @orcasynapse/database db:generate",
    "db:validate": "pnpm --filter @orcasynapse/database db:check",
    "verify:postgres": "pnpm --filter @orcasynapse/database verify:postgres"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "concurrently": "10.0.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
