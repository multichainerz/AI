{
  "name": "mpm-aihub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "24.13.3"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "concurrently --kill-others --names api,web \"pnpm --filter @aihub/api dev\" \"pnpm --filter @aihub/web dev\"",
    "dev:worker": "pnpm --filter @aihub/worker dev",
    "pretypecheck": "pnpm --filter @aihub/contracts --filter @aihub/database --filter @aihub/security --filter @aihub/document-runtime build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm db:validate",
    "security:audit": "pnpm audit --prod --audit-level high",
    "admin:provision": "node scripts/provision-local-admin.mjs",
    "db:generate": "pnpm --filter @aihub/database prisma:generate",
    "db:validate": "pnpm --filter @aihub/database prisma:validate",
    "verify:postgres": "pnpm --filter @aihub/database verify:postgres"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "concurrently": "10.0.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
