{
  "name": "@orcasynapse/worker",
  "version": "3.5.0",
  "description": "OrcaSynapse worker: agent run execution and background processing",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude=dist/**"
  },
  "dependencies": {
    "@orcasynapse/contracts": "workspace:*",
    "@orcasynapse/database": "workspace:*",
    "@orcasynapse/knowledge": "workspace:*",
    "@orcasynapse/runtime-clients": "workspace:*",
    "@orcasynapse/security": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "tsx": "4.23.1"
  }
}
