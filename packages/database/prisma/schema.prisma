generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ServiceKind {
  LITELLM
  VLLM
  HERMES
  SUPERMEMORY
  OCR
  MCP
  OIDC
  SIEM
  NOTIFICATION
  OTHER
}

enum DeploymentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum ConnectionStatus {
  NOT_TESTED
  HEALTHY
  DEGRADED
  UNREACHABLE
  DISABLED
}

enum AuditActorType {
  USER
  SERVICE
  SYSTEM
}

enum WorkerLifecycleStatus {
  ONLINE
  STOPPED
}

enum AdministratorRole {
  PLATFORM_ADMIN
  SECURITY_ADMIN
  OPERATIONS_ADMIN
  AUDITOR
}

enum ChatConversationStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum ChatMessageStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ChatFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum DocumentStatus {
  QUARANTINED
  QUEUED
  CONVERTING
  OCR_PENDING
  OCR_PROCESSING
  READY
  FAILED
  REJECTED
  DELETING
  DELETED
}

enum DocumentClassification {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum MemorySyncStatus {
  NOT_INDEXED
  QUEUED
  PROCESSING
  READY
  FAILED
  DELETE_PENDING
  DELETED
}

enum AgentProfileStatus {
  DRAFT
  STANDBY
  ACTIVE
  SUSPENDED
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  CANCEL_REQUESTED
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
  DENIED
}

enum ToolRisk {
  READ_ONLY
  CONSEQUENTIAL
}

enum ToolStatus {
  ACTIVE
  SUSPENDED
}

enum ToolCallStatus {
  REQUESTED
  APPROVAL_PENDING
  EXECUTING
  COMPLETED
  FAILED
  DENIED
  CANCELLED
}

enum ToolApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ToolActionDispatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ToolResourceScope {
  OWNER_ONLY
}

enum OperationalIncidentSeverity {
  WARNING
  CRITICAL
}

enum OperationalIncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum EvaluationTargetType {
  MODEL
  PROMPT
  POLICY
  AGENT
}

enum EvaluationRunStatus {
  DRAFT
  PASSED
  FAILED
  PROMOTED
}

enum ModelWorkload {
  CHAT
  AGENT
  EMBEDDING
  OCR
}

enum ModelDeploymentStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum GuardrailPolicyStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum PromptPurpose {
  CHAT_SYSTEM
}

enum PromptTemplateStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum ProductionReadinessDomain {
  SECURITY
  INFRASTRUCTURE
  RECOVERY
  OPERATIONS
  TRAINING
  BUSINESS
}

enum ProductionReadinessControlStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  VERIFIED
  WAIVED
}

enum ProductionReadinessApprovalRole {
  SECURITY
  INFRASTRUCTURE
  PRODUCT
  BUSINESS
}

enum ProductionReadinessApprovalDecision {
  APPROVED
  REJECTED
}

enum ComponentCompatibilityStatus {
  NOT_TESTED
  IN_PROGRESS
  PASSED
  FAILED
  BLOCKED
}

enum OnboardingJourneyStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum OnboardingStepStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum LiteLlmOwnershipMode {
  EXTERNAL_VALIDATED
  PINNED_API_RECONCILED
}

enum SupermemoryStorageMode {
  EMBEDDED
  SUPPORTED_EXTERNAL_POSTGRES
}

enum SupermemoryEmbeddingMode {
  LOCAL
  OPENAI_COMPATIBLE
}

enum HermesMemoryMode {
  MEDIATED
  NATIVE_SUPERMEMORY
}

enum GpuSchedulingMode {
  DEDICATED_LLM
  MEASURED_CO_RESIDENCY
  SERIALIZED_DEGRADED
}

enum DeploymentTopologyMode {
  COMPACT
  CONTROL_PLANE
  SEGMENTED_PRODUCTION
}

enum OnboardingTargetEnvironment {
  DEVELOPMENT
  PILOT
  PRODUCTION
}

enum DeploymentInstallMethod {
  SIGNED_INSTALLER
}

enum OnboardingEvidenceSource {
  AUTOMATED
  EXTERNAL_ATTESTATION
}

enum OnboardingEvidenceOutcome {
  PASSED
  FAILED
  WARNING
}

enum HermesRuntimeNodeStatus {
  PENDING
  ONLINE
  DEGRADED
  DRAINING
  SUSPENDED
  REVOKED
  OFFLINE
}

enum HermesNodeEnrollmentStatus {
  ISSUED
  CONSUMED
  REVOKED
  EXPIRED
}

model AdministratorSession {
  id                String            @id @default(uuid()) @db.Uuid
  tokenHash         Bytes             @unique
  subject           String            @db.VarChar(160)
  role              AdministratorRole
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime          @db.Timestamptz(6)
  idleExpiresAt     DateTime          @db.Timestamptz(6)
  absoluteExpiresAt DateTime          @db.Timestamptz(6)
  revokedAt         DateTime?         @db.Timestamptz(6)
  sourceIp          String?           @db.Inet
  userAgentHash     String?           @db.VarChar(64)

  @@index([revokedAt, idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@index([subject, createdAt])
}

model ServiceConnection {
  id                        String                     @id @default(uuid()) @db.Uuid
  slug                      String                     @unique @db.VarChar(64)
  displayName               String                     @db.VarChar(120)
  kind                      ServiceKind
  environment               DeploymentEnvironment
  baseUrl                   String?                    @db.Text
  enabled                   Boolean                    @default(false)
  status                    ConnectionStatus           @default(NOT_TESTED)
  configuration             Json                       @default("{}")
  activeRevision            Int                        @default(1)
  lastHealthcheckAt         DateTime?                  @db.Timestamptz(6)
  lastHealthcheckMessage    String?                    @db.Text
  monitoringClaimedAt       DateTime?                  @db.Timestamptz(6)
  monitoringClaimedBy       String?                    @db.VarChar(200)
  monitoringClaimToken      String?                    @db.Uuid
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(6)
  secrets                   SecretRecord[]
  revisions                 ConfigurationRevision[]
  modelDeployments          ModelDeployment[]
  oidcAuthorizationRequests OidcAuthorizationRequest[]
  hermesRuntimeNode         HermesRuntimeNode?

  @@index([kind, environment])
  @@index([enabled, status])
  @@index([monitoringClaimedAt])
}

model ModelDeployment {
  id                     String                @id @default(uuid()) @db.Uuid
  slug                   String                @unique @db.VarChar(64)
  displayName            String                @db.VarChar(120)
  modelAlias             String                @db.VarChar(200)
  workload               ModelWorkload
  status                 ModelDeploymentStatus @default(DRAFT)
  connectionId           String                @db.Uuid
  version                String                @db.VarChar(120)
  license                String?               @db.VarChar(160)
  contextWindowTokens    Int
  maxOutputTokens        Int
  maxConcurrentRequests  Int
  isDefault              Boolean               @default(false)
  activationEvaluationId String?               @db.Uuid
  firstActivatedAt       DateTime?             @db.Timestamptz(6)
  revision               Int                   @default(1)
  createdBy              String?               @db.Uuid
  updatedBy              String?               @db.Uuid
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)
  connection             ServiceConnection     @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  activationEvaluation   EvaluationRun?        @relation(fields: [activationEvaluationId], references: [id], onDelete: SetNull)

  @@unique([workload, modelAlias])
  @@index([workload, status])
  @@index([connectionId])
  @@index([activationEvaluationId])
}

model GuardrailPolicy {
  id                     String                @id @default(uuid()) @db.Uuid
  slug                   String                @unique @db.VarChar(64)
  displayName            String                @db.VarChar(120)
  description            String                @db.VarChar(500)
  version                String                @db.VarChar(120)
  status                 GuardrailPolicyStatus @default(DRAFT)
  liteLLMGuardrails      String[]
  maxInputCharacters     Int
  activationEvaluationId String?               @db.Uuid
  firstActivatedAt       DateTime?             @db.Timestamptz(6)
  revision               Int                   @default(1)
  createdBy              String?               @db.Uuid
  updatedBy              String?               @db.Uuid
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)
  activationEvaluation   EvaluationRun?        @relation(fields: [activationEvaluationId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([activationEvaluationId])
}

model PromptTemplate {
  id                     String               @id @default(uuid()) @db.Uuid
  slug                   String               @unique @db.VarChar(64)
  displayName            String               @db.VarChar(120)
  description            String               @db.VarChar(500)
  purpose                PromptPurpose
  version                String               @db.VarChar(120)
  status                 PromptTemplateStatus @default(DRAFT)
  content                String               @db.Text
  contentChecksum        String               @db.VarChar(64)
  activationEvaluationId String?              @db.Uuid
  firstActivatedAt       DateTime?            @db.Timestamptz(6)
  revision               Int                  @default(1)
  createdBy              String?              @db.Uuid
  updatedBy              String?              @db.Uuid
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(6)
  activationEvaluation   EvaluationRun?       @relation(fields: [activationEvaluationId], references: [id], onDelete: SetNull)

  @@index([purpose, status])
  @@index([activationEvaluationId])
}

model ConnectionMonitoringControl {
  id              String   @id @default("global") @db.VarChar(32)
  enabled         Boolean  @default(false)
  intervalSeconds Int      @default(300)
  reason          String?  @db.VarChar(500)
  updatedBy       String?  @db.Uuid
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
}

model SecretRecord {
  id                  String            @id @default(uuid()) @db.Uuid
  serviceConnectionId String            @db.Uuid
  fieldName           String            @db.VarChar(120)
  encryptedValue      Bytes
  valueNonce          Bytes
  valueAuthTag        Bytes
  wrappedDataKey      Bytes
  keyNonce            Bytes
  keyAuthTag          Bytes
  encryptionVersion   Int               @default(1)
  masterKeyVersion    Int               @default(1)
  active              Boolean           @default(true)
  createdBy           String?           @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  retiredAt           DateTime?         @db.Timestamptz(6)
  serviceConnection   ServiceConnection @relation(fields: [serviceConnectionId], references: [id], onDelete: Cascade)

  @@index([serviceConnectionId, fieldName, active])
  @@index([createdAt])
}

model ConfigurationRevision {
  id                  String            @id @default(uuid()) @db.Uuid
  serviceConnectionId String            @db.Uuid
  revision            Int
  configuration       Json
  secretFieldNames    String[]
  checksum            String            @db.VarChar(64)
  createdBy           String?           @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  activatedAt         DateTime?         @db.Timestamptz(6)
  serviceConnection   ServiceConnection @relation(fields: [serviceConnectionId], references: [id], onDelete: Cascade)

  @@unique([serviceConnectionId, revision])
  @@index([createdAt])
}

model AuditEvent {
  id            String         @id @default(uuid()) @db.Uuid
  occurredAt    DateTime       @default(now()) @db.Timestamptz(6)
  actorType     AuditActorType
  actorId       String?        @db.Uuid
  action        String         @db.VarChar(160)
  resourceType  String         @db.VarChar(120)
  resourceId    String?        @db.VarChar(160)
  outcome       String         @db.VarChar(40)
  correlationId String?        @db.Uuid
  sourceIp      String?        @db.Inet
  metadata      Json           @default("{}")

  @@index([occurredAt])
  @@index([resourceType, resourceId])
  @@index([actorId, occurredAt])
  @@index([correlationId])
}

model WorkerNode {
  id         String                @id @db.VarChar(160)
  name       String                @db.VarChar(160)
  version    String                @db.VarChar(40)
  status     WorkerLifecycleStatus @default(ONLINE)
  queues     String[]
  metadata   Json                  @default("{}")
  startedAt  DateTime              @db.Timestamptz(6)
  lastSeenAt DateTime              @db.Timestamptz(6)
  stoppedAt  DateTime?             @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime              @updatedAt @db.Timestamptz(6)

  @@index([status, lastSeenAt])
  @@index([lastSeenAt])
}

model OperationalIncident {
  id                String                      @id @default(uuid()) @db.Uuid
  activeFingerprint String?                     @unique @db.VarChar(160)
  title             String                      @db.VarChar(160)
  severity          OperationalIncidentSeverity
  status            OperationalIncidentStatus   @default(OPEN)
  component         String                      @db.VarChar(80)
  summary           String                      @db.VarChar(1000)
  owner             String?                     @db.VarChar(160)
  automated         Boolean                     @default(false)
  detectedAt        DateTime                    @default(now()) @db.Timestamptz(6)
  lastObservedAt    DateTime                    @default(now()) @db.Timestamptz(6)
  acknowledgedBy    String?                     @db.Uuid
  acknowledgedAt    DateTime?                   @db.Timestamptz(6)
  resolvedBy        String?                     @db.Uuid
  resolvedAt        DateTime?                   @db.Timestamptz(6)
  resolutionNote    String?                     @db.VarChar(1000)
  createdAt         DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                    @updatedAt @db.Timestamptz(6)

  @@index([status, severity, detectedAt])
  @@index([component, status])
  @@index([owner, status])
}

model EvaluationRun {
  id                         String               @id @default(uuid()) @db.Uuid
  name                       String               @db.VarChar(160)
  targetType                 EvaluationTargetType
  targetReference            String               @db.VarChar(240)
  targetVersion              String               @db.VarChar(120)
  status                     EvaluationRunStatus  @default(DRAFT)
  minimumPassRate            Float
  requiredCategories         String[]
  categoryResults            Json                 @default("[]")
  totalCases                 Int                  @default(0)
  passedCases                Int                  @default(0)
  criticalFailures           Int                  @default(0)
  createdBy                  String?              @db.Uuid
  completedAt                DateTime?            @db.Timestamptz(6)
  promotedBy                 String?              @db.Uuid
  promotedAt                 DateTime?            @db.Timestamptz(6)
  promotionReason            String?              @db.VarChar(1000)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime             @updatedAt @db.Timestamptz(6)
  activatedModels            ModelDeployment[]
  activatedGuardrailPolicies GuardrailPolicy[]
  activatedPromptTemplates   PromptTemplate[]

  @@index([status, createdAt])
  @@index([targetType, targetReference, targetVersion])
}

model ProductionReadinessControl {
  key           String                           @id @db.VarChar(80)
  title         String                           @db.VarChar(160)
  domain        ProductionReadinessDomain
  description   String                           @db.VarChar(1000)
  status        ProductionReadinessControlStatus @default(NOT_STARTED)
  owner         String?                          @db.VarChar(160)
  evidenceRefs  String[]                         @default([])
  note          String?                          @db.VarChar(1000)
  lastUpdatedBy String?                          @db.VarChar(160)
  verifiedAt    DateTime?                        @db.Timestamptz(6)
  revision      Int                              @default(0)
  createdAt     DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                         @updatedAt @db.Timestamptz(6)

  @@index([domain, status])
  @@index([status, updatedAt])
}

model ProductionReadinessApproval {
  id               String                              @id @default(uuid()) @db.Uuid
  role             ProductionReadinessApprovalRole
  decision         ProductionReadinessApprovalDecision
  authority        String                              @db.VarChar(160)
  evidenceRef      String                              @db.VarChar(500)
  reason           String                              @db.VarChar(1000)
  recordedBy       String                              @db.VarChar(160)
  recordedAt       DateTime                            @default(now()) @db.Timestamptz(6)
  controlRevisions Json                                @default("{}")

  @@index([role, recordedAt])
  @@index([decision, recordedAt])
}

model PlatformArchitectureDecision {
  id                       String                     @id @default("global") @db.VarChar(32)
  topologyMode             DeploymentTopologyMode     @default(CONTROL_PLANE)
  targetEnvironment        OnboardingTargetEnvironment @default(DEVELOPMENT)
  installMethod            DeploymentInstallMethod    @default(SIGNED_INSTALLER)
  localInference           Boolean                    @default(false)
  liteLlmOwnershipMode     LiteLlmOwnershipMode       @default(EXTERNAL_VALIDATED)
  supermemoryStorageMode   SupermemoryStorageMode     @default(EMBEDDED)
  supermemoryEmbeddingMode SupermemoryEmbeddingMode   @default(LOCAL)
  hermesMemoryMode         HermesMemoryMode           @default(MEDIATED)
  gpuSchedulingMode        GpuSchedulingMode          @default(DEDICATED_LLM)
  reason                   String?                    @db.VarChar(1000)
  revision                 Int                        @default(0)
  updatedBy                String?                    @db.Uuid
  createdAt                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                   @updatedAt @db.Timestamptz(6)
}

model ComponentCompatibility {
  key              String                       @id @db.VarChar(80)
  displayName      String                       @db.VarChar(160)
  category         String                       @db.VarChar(80)
  required         Boolean                      @default(true)
  expectedContract String                       @db.VarChar(1000)
  status           ComponentCompatibilityStatus @default(NOT_TESTED)
  observedVersion  String?                      @db.VarChar(240)
  evidenceRef      String?                      @db.VarChar(500)
  note             String?                      @db.VarChar(1000)
  testedAt         DateTime?                    @db.Timestamptz(6)
  updatedBy        String?                      @db.Uuid
  revision         Int                          @default(0)
  createdAt        DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                     @updatedAt @db.Timestamptz(6)

  @@index([required, status])
  @@index([category, status])
}

model OnboardingJourney {
  id             String                  @id @default("global") @db.VarChar(32)
  status         OnboardingJourneyStatus @default(NOT_STARTED)
  currentStepKey String?                 @db.VarChar(80)
  reason         String?                 @db.VarChar(1000)
  revision       Int                     @default(0)
  startedAt      DateTime?               @db.Timestamptz(6)
  completedAt    DateTime?               @db.Timestamptz(6)
  activatedEnvironment OnboardingTargetEnvironment?
  updatedBy      String?                 @db.Uuid
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(6)
}

model OnboardingStep {
  key          String               @id @db.VarChar(80)
  ordinal      Int
  title        String               @db.VarChar(160)
  description  String               @db.VarChar(1000)
  required     Boolean              @default(true)
  status       OnboardingStepStatus @default(NOT_STARTED)
  evidenceRefs String[]             @default([])
  note         String?              @db.VarChar(1000)
  revision     Int                  @default(0)
  updatedBy    String?              @db.Uuid
  completedAt  DateTime?            @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)

  @@unique([ordinal])
  @@index([status, ordinal])
}

model InstallationClaim {
  id                String    @id @default("initial") @db.VarChar(32)
  tokenHash         Bytes     @unique
  expiresAt         DateTime? @db.Timestamptz(6)
  redeemedAt        DateTime? @db.Timestamptz(6)
  redeemedSessionId String?   @db.Uuid
  sourceIp          String?   @db.Inet
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@index([redeemedAt, expiresAt])
}

model CredentialRecoveryControl {
  id             String    @id @default("global") @db.VarChar(32)
  keyFingerprint String?   @db.VarChar(64)
  kitChecksum    String?   @db.VarChar(64)
  recoveryOwner  String?   @db.VarChar(160)
  exportedAt     DateTime? @db.Timestamptz(6)
  exportedBy     String?   @db.Uuid
  verifiedAt     DateTime? @db.Timestamptz(6)
  verifiedBy     String?   @db.Uuid
  revision       Int       @default(0)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
}

model OnboardingEvidence {
  id              String                    @id @default(uuid()) @db.Uuid
  stageKey        String                    @db.VarChar(80)
  componentKey    String?                   @db.VarChar(80)
  source          OnboardingEvidenceSource
  outcome         OnboardingEvidenceOutcome
  code            String                    @db.VarChar(120)
  summary         String                    @db.VarChar(1000)
  observedVersion String?                   @db.VarChar(240)
  details         Json                      @default("{}")
  createdBy       String?                   @db.Uuid
  createdAt       DateTime                  @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime?                 @db.Timestamptz(6)

  @@index([stageKey, createdAt])
  @@index([componentKey, createdAt])
  @@index([source, outcome, createdAt])
}

model HermesRuntimeNode {
  id                      String                  @id @default(uuid()) @db.Uuid
  slug                    String                  @unique @db.VarChar(64)
  displayName             String                  @db.VarChar(120)
  baseUrl                 String                  @db.Text
  expectedHostname        String?                 @db.VarChar(253)
  hostname                String?                 @db.VarChar(253)
  status                  HermesRuntimeNodeStatus @default(PENDING)
  identityPublicKeyPem    String?                 @db.Text
  identityFingerprint     String?                 @unique @db.VarChar(64)
  hermesVersion           String?                 @db.VarChar(120)
  installerVersion        String?                 @db.VarChar(120)
  capabilities            Json                    @default("[]")
  serviceConnectionId     String?                 @unique @db.Uuid
  lastSeenAt              DateTime?               @db.Timestamptz(6)
  enrolledAt              DateTime?               @db.Timestamptz(6)
  revokedAt               DateTime?               @db.Timestamptz(6)
  revision                Int                     @default(0)
  createdBy               String?                 @db.Uuid
  createdAt               DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(6)
  serviceConnection       ServiceConnection?      @relation(fields: [serviceConnectionId], references: [id], onDelete: SetNull)
  enrollments             HermesNodeEnrollment[]
  requestNonces           HermesNodeRequestNonce[]

  @@index([status, lastSeenAt])
  @@index([createdAt])
}

model HermesNodeEnrollment {
  id               String                     @id @default(uuid()) @db.Uuid
  nodeId           String                     @db.Uuid
  tokenHash        Bytes                      @unique
  status           HermesNodeEnrollmentStatus @default(ISSUED)
  expiresAt        DateTime                   @db.Timestamptz(6)
  consumedAt       DateTime?                  @db.Timestamptz(6)
  revokedAt        DateTime?                  @db.Timestamptz(6)
  consumedSourceIp String?                    @db.Inet
  createdBy        String?                    @db.Uuid
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(6)
  node             HermesRuntimeNode          @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, status])
  @@index([status, expiresAt])
}

model HermesNodeRequestNonce {
  id         String            @id @default(uuid()) @db.Uuid
  nodeId     String            @db.Uuid
  nonce      String            @db.Uuid
  receivedAt DateTime          @default(now()) @db.Timestamptz(6)
  node       HermesRuntimeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, nonce])
  @@index([receivedAt])
}

model ChatConversation {
  id            String                 @id @default(uuid()) @db.Uuid
  ownerSubject  String                 @db.VarChar(200)
  title         String                 @db.VarChar(160)
  modelAlias    String                 @db.VarChar(200)
  status        ChatConversationStatus @default(ACTIVE)
  generation    Int                    @default(0)
  lastMessageAt DateTime?              @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(6)
  messages      ChatMessage[]

  @@index([ownerSubject, status, updatedAt])
  @@index([lastMessageAt])
}

model ChatMessage {
  id                String            @id @default(uuid()) @db.Uuid
  conversationId    String            @db.Uuid
  ordinal           Int
  role              ChatMessageRole
  status            ChatMessageStatus
  content           String            @db.Text
  modelAlias        String?           @db.VarChar(200)
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  latencyMs         Int?
  finishReason      String?           @db.VarChar(120)
  providerRequestId String?           @db.VarChar(200)
  errorCode         String?           @db.VarChar(80)
  sources           Json              @default("[]")
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  completedAt       DateTime?         @db.Timestamptz(6)
  conversation      ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback          ChatFeedback?

  @@unique([conversationId, ordinal])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model ChatFeedback {
  id           String             @id @default(uuid()) @db.Uuid
  messageId    String             @unique @db.Uuid
  ownerSubject String             @db.VarChar(200)
  rating       ChatFeedbackRating
  comment      String?            @db.VarChar(1000)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)
  message      ChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ownerSubject, createdAt])
  @@index([rating, createdAt])
}

model EnterpriseUser {
  id          String                  @id @default(uuid()) @db.Uuid
  issuer      String                  @db.VarChar(512)
  subject     String                  @db.VarChar(255)
  email       String?                 @db.VarChar(320)
  displayName String                  @db.VarChar(200)
  groups      String[]
  enabled     Boolean                 @default(true)
  lastLoginAt DateTime                @db.Timestamptz(6)
  createdAt   DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(6)
  sessions    EnterpriseUserSession[]

  @@unique([issuer, subject])
  @@index([email])
  @@index([enabled, lastLoginAt])
}

model EnterpriseUserSession {
  id                String         @id @default(uuid()) @db.Uuid
  tokenHash         Bytes          @unique
  userId            String         @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime       @db.Timestamptz(6)
  idleExpiresAt     DateTime       @db.Timestamptz(6)
  absoluteExpiresAt DateTime       @db.Timestamptz(6)
  revokedAt         DateTime?      @db.Timestamptz(6)
  sourceIp          String?        @db.Inet
  userAgentHash     String?        @db.VarChar(64)
  user              EnterpriseUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([revokedAt, idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model OidcAuthorizationRequest {
  id                         String            @id @default(uuid()) @db.Uuid
  serviceConnectionId        String            @db.Uuid
  stateHash                  Bytes             @unique
  nonce                      String            @db.VarChar(86)
  returnTo                   String            @db.VarChar(500)
  issuer                     String            @db.VarChar(512)
  tokenEndpoint              String            @db.VarChar(2048)
  jwksUri                    String            @db.VarChar(2048)
  clientId                   String            @db.VarChar(256)
  redirectUri                String            @db.VarChar(2048)
  codeVerifierEncryptedValue Bytes
  codeVerifierValueNonce     Bytes
  codeVerifierValueAuthTag   Bytes
  codeVerifierWrappedDataKey Bytes
  codeVerifierKeyNonce       Bytes
  codeVerifierKeyAuthTag     Bytes
  encryptionVersion          Int               @default(1)
  masterKeyVersion           Int               @default(1)
  createdAt                  DateTime          @default(now()) @db.Timestamptz(6)
  expiresAt                  DateTime          @db.Timestamptz(6)
  consumedAt                 DateTime?         @db.Timestamptz(6)
  serviceConnection          ServiceConnection @relation(fields: [serviceConnectionId], references: [id], onDelete: Cascade)

  @@index([expiresAt, consumedAt])
  @@index([serviceConnectionId, createdAt])
}

model Document {
  id                   String                     @id @default(uuid()) @db.Uuid
  ownerSubject         String                     @db.VarChar(200)
  fileName             String                     @db.VarChar(255)
  mediaType            String                     @db.VarChar(160)
  sizeBytes            BigInt
  sha256               String                     @db.VarChar(64)
  classification       DocumentClassification
  status               DocumentStatus             @default(QUARANTINED)
  stagingKey           String?                    @db.VarChar(1024)
  stagingExpiresAt     DateTime?                  @db.Timestamptz(6)
  stagingPurgedAt      DateTime?                  @db.Timestamptz(6)
  pageCount            Int?
  processingGeneration Int                        @default(0)
  failureCode          String?                    @db.VarChar(80)
  failureMessage       String?                    @db.VarChar(500)
  retentionUntil       DateTime                   @db.Timestamptz(6)
  approvedAt           DateTime?                  @db.Timestamptz(6)
  approvedBy           String?                    @db.Uuid
  completedAt          DateTime?                  @db.Timestamptz(6)
  deletedAt            DateTime?                  @db.Timestamptz(6)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(6)
  processingRuns       DocumentProcessingRun[]
  memoryPublication    DocumentMemoryPublication?

  @@index([ownerSubject, status, updatedAt])
  @@index([status, createdAt])
  @@index([retentionUntil, status])
  @@index([stagingExpiresAt, stagingPurgedAt])
  @@index([sha256])
}

model DocumentMemoryPublication {
  id                   String           @id @default(uuid()) @db.Uuid
  documentId           String           @unique @db.Uuid
  ownerSubject         String           @db.VarChar(200)
  scopeTag             String           @db.VarChar(100)
  generation           Int              @default(0)
  status               MemorySyncStatus @default(NOT_INDEXED)
  externalDocumentId   String?          @db.VarChar(255)
  jobId                String?          @db.Uuid
  sourceToolDispatchId String?          @db.Uuid
  failureCode          String?          @db.VarChar(80)
  failureMessage       String?          @db.VarChar(500)
  queuedAt             DateTime?        @db.Timestamptz(6)
  syncedAt             DateTime?        @db.Timestamptz(6)
  deletedAt            DateTime?        @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(6)
  document             Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([ownerSubject, status, updatedAt])
  @@index([status, queuedAt])
  @@index([scopeTag, status])
  @@index([sourceToolDispatchId])
}

model AgentProfile {
  id             String                @id @default(uuid()) @db.Uuid
  slug           String                @unique @db.VarChar(64)
  status         AgentProfileStatus    @default(DRAFT)
  currentVersion Int                   @default(1)
  activeVersion  Int?
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(6)
  versions       AgentProfileVersion[]
  runs           AgentRun[]

  @@index([status, updatedAt])
}

model AgentProfileVersion {
  id                    String           @id @default(uuid()) @db.Uuid
  profileId             String           @db.Uuid
  version               Int
  displayName           String           @db.VarChar(120)
  purpose               String           @db.VarChar(500)
  instructions          String           @db.Text
  soulMd                String           @default("") @db.Text
  skills                Json             @default("[]")
  distributionDigest    String?          @db.VarChar(64)
  modelAlias            String           @db.VarChar(200)
  maxTurns              Int
  timeoutSeconds        Int
  maxConcurrentRuns     Int
  allowPrivateKnowledge Boolean          @default(false)
  safeMode              Boolean          @default(true)
  createdBy             String?          @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  profile               AgentProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  runs                  AgentRun[]
  toolGrants            AgentToolGrant[]

  @@unique([profileId, version])
  @@index([profileId, createdAt])
}

model AgentRun {
  id                      String              @id @default(uuid()) @db.Uuid
  profileId               String              @db.Uuid
  profileVersionId        String              @db.Uuid
  profileVersion          Int
  profileDistributionDigest String?            @db.VarChar(64)
  ownerSubject            String              @db.VarChar(200)
  requestedBy             String              @db.Uuid
  status                  AgentRunStatus      @default(QUEUED)
  input                   String              @db.Text
  output                  String?             @db.Text
  effectiveCapabilities   Json                @default("[]")
  sources                 Json                @default("[]")
  toolCapabilityTokenHash Bytes?
  toolCapabilityExpiresAt DateTime?           @db.Timestamptz(6)
  externalRunId           String?             @db.VarChar(255)
  jobId                   String?             @db.Uuid
  failureCode             String?             @db.VarChar(80)
  failureMessage          String?             @db.VarChar(500)
  queuedAt                DateTime            @default(now()) @db.Timestamptz(6)
  startedAt               DateTime?           @db.Timestamptz(6)
  completedAt             DateTime?           @db.Timestamptz(6)
  createdAt               DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(6)
  profile                 AgentProfile        @relation(fields: [profileId], references: [id], onDelete: Restrict)
  version                 AgentProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)
  toolCalls               GovernedToolCall[]
  events                  AgentRunEvent[]

  @@index([ownerSubject, createdAt])
  @@index([profileId, status, createdAt])
  @@index([status, queuedAt])
}

model AgentRunEvent {
  id             String   @id @default(uuid()) @db.Uuid
  runId          String   @db.Uuid
  sourceEventId  String?  @db.VarChar(255)
  type           String   @db.VarChar(80)
  summary        String?  @db.VarChar(1000)
  status         String?  @db.VarChar(80)
  toolName       String?  @db.VarChar(160)
  childSessionId String?  @db.VarChar(255)
  durationMs     Int?
  inputTokens    Int?
  outputTokens   Int?
  costUsd        Decimal? @db.Decimal(18, 8)
  occurredAt     DateTime @default(now()) @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sourceEventId])
  @@index([runId, occurredAt, id])
}

model AgentRuntimeControl {
  id        String   @id @default("global") @db.VarChar(32)
  enabled   Boolean  @default(false)
  reason    String?  @db.VarChar(500)
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model GovernedTool {
  id          String             @id @default(uuid()) @db.Uuid
  slug        String             @unique @db.VarChar(80)
  displayName String             @db.VarChar(120)
  description String             @db.VarChar(1000)
  risk        ToolRisk
  status      ToolStatus         @default(ACTIVE)
  handlerKey  String             @db.VarChar(120)
  inputSchema Json
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  grants      AgentToolGrant[]
  calls       GovernedToolCall[]

  @@index([status, risk])
}

model AgentToolGrant {
  id                String              @id @default(uuid()) @db.Uuid
  profileVersionId  String              @db.Uuid
  toolId            String              @db.Uuid
  enabled           Boolean             @default(true)
  allowedGroups     String[]
  allowedAdminRoles AdministratorRole[]
  resourceScope     ToolResourceScope   @default(OWNER_ONLY)
  createdBy         String?             @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(6)
  profileVersion    AgentProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)
  tool              GovernedTool        @relation(fields: [toolId], references: [id], onDelete: Restrict)
  calls             GovernedToolCall[]

  @@unique([profileVersionId, toolId])
  @@index([toolId, enabled])
}

model McpGatewayCredential {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  tokenPrefix String    @unique @db.VarChar(32)
  tokenHash   Bytes     @unique
  enabled     Boolean   @default(true)
  lastUsedAt  DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([enabled, revokedAt])
}

model GovernedToolCall {
  id             String              @id @default(uuid()) @db.Uuid
  runId          String              @db.Uuid
  toolId         String              @db.Uuid
  grantId        String              @db.Uuid
  requestId      String              @db.Uuid
  status         ToolCallStatus      @default(REQUESTED)
  arguments      Json
  result         Json?
  errorCode      String?             @db.VarChar(80)
  errorMessage   String?             @db.VarChar(500)
  requestedAt    DateTime            @default(now()) @db.Timestamptz(6)
  startedAt      DateTime?           @db.Timestamptz(6)
  completedAt    DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  run            AgentRun            @relation(fields: [runId], references: [id], onDelete: Restrict)
  tool           GovernedTool        @relation(fields: [toolId], references: [id], onDelete: Restrict)
  grant          AgentToolGrant      @relation(fields: [grantId], references: [id], onDelete: Restrict)
  approval       ToolApproval?
  actionDispatch ToolActionDispatch?

  @@unique([runId, requestId])
  @@index([runId, createdAt])
  @@index([toolId, status, createdAt])
  @@index([status, requestedAt])
}

model ToolActionDispatch {
  id             String                   @id @default(uuid()) @db.Uuid
  callId         String                   @unique @db.Uuid
  status         ToolActionDispatchStatus @default(PENDING)
  attemptCount   Int                      @default(0)
  nextAttemptAt  DateTime                 @default(now()) @db.Timestamptz(6)
  claimedAt      DateTime?                @db.Timestamptz(6)
  claimedBy      String?                  @db.VarChar(200)
  claimToken     String?                  @db.Uuid
  submittedJobId String?                  @db.Uuid
  lastError      String?                  @db.VarChar(500)
  completedAt    DateTime?                @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)
  call           GovernedToolCall         @relation(fields: [callId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([claimedAt])
}

model ToolApproval {
  id             String             @id @default(uuid()) @db.Uuid
  callId         String             @unique @db.Uuid
  status         ToolApprovalStatus @default(PENDING)
  expiresAt      DateTime           @db.Timestamptz(6)
  decisionReason String?            @db.VarChar(1000)
  decisionBy     String?            @db.Uuid
  decidedAt      DateTime?          @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  call           GovernedToolCall   @relation(fields: [callId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
}

model ToolRuntimeControl {
  id                 String   @id @default("global") @db.VarChar(32)
  enabled            Boolean  @default(false)
  reason             String?  @db.VarChar(500)
  approvalTtlMinutes Int      @default(15)
  updatedBy          String?  @db.Uuid
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)
}

model DocumentProcessingRun {
  id              String    @id @default(uuid()) @db.Uuid
  documentId      String    @db.Uuid
  generation      Int
  conversionJobId String?   @db.Uuid
  ocrJobId        String?   @db.Uuid
  startedAt       DateTime? @db.Timestamptz(6)
  completedAt     DateTime? @db.Timestamptz(6)
  failedAt        DateTime? @db.Timestamptz(6)
  failureCode     String?   @db.VarChar(80)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, generation])
  @@index([conversionJobId])
  @@index([ocrJobId])
}
