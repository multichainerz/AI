{
  "name": "@orcasynapse/runtime-clients",
  "version": "3.10.0",
  "description": "Typed clients for the Hermes runtime and OpenAI-compatible inference services",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude=dist/**"
  },
  "dependencies": {
    "@orcasynapse/contracts": "workspace:*",
    "@orcasynapse/database": "workspace:*",
    "@orcasynapse/security": "workspace:*",
    "drizzle-orm": "0.45.2"
  }
}
