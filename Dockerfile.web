FROM node:24-bookworm-slim AS builder

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json

RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY packages/contracts packages/contracts

RUN pnpm --filter @orcasynapse/web... build

FROM nginx:1.29-alpine

# The proxy configuration carries one operator-declared value,
# ORCASYNAPSE_PUBLIC_SCHEME, so it is installed as a template: the image's
# entrypoint runs envsubst over /etc/nginx/templates into /etc/nginx/conf.d
# before nginx starts. Left in /etc/nginx/conf.d it would be served verbatim and
# nginx would reject the unrendered placeholder.
#
# The default is pinned here rather than only in compose.yaml. envsubst
# substitutes nothing for a variable that is not set, leaving the literal
# ${ORCASYNAPSE_PUBLIC_SCHEME} behind, and nginx refuses to start on an unknown
# variable -- so the image has to be correct when it is run without Compose.
# http is the safe end of that default: it withholds Secure rather than claiming
# a TLS session that a plain-HTTP deployment does not have.
ENV ORCASYNAPSE_PUBLIC_SCHEME=http
# Restrict the substitution to OrcaSynapse's own names. Unfiltered, envsubst
# replaces every environment variable the template mentions, so a variable named
# "host" or "uri" in the container environment silently rewrites $host and $uri
# out of the proxy configuration.
ENV NGINX_ENVSUBST_FILTER=^ORCASYNAPSE_
COPY deploy/nginx/default.conf /etc/nginx/templates/default.conf.template
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080
